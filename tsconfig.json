{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "declaration": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ]
}
